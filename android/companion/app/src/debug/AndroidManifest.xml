<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pinky on the phone itself talks to the AI model the person chose,
         and fetches its updates from Pinky's releases. Only builds that run
         tasks on the phone (on_phone_ui) need it; it moves to the main
         manifest when release builds turn on_phone_ui on
         (docs/notes/android-app.md). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Installing an update from Pinky's releases (UpdateInstall), after
         Android asks the person. Moves to the main manifest with INTERNET:
         without it, a release build cannot download an update anyway. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
