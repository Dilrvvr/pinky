<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for the debug page's test notification. Never requested at run time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android's own dialog to lift Pinky's battery limits (Battery), so
         that a long task on the phone is not stopped in the background.
         Only Pinky's screens for tasks on the phone (on_phone_ui) ask.
         Pinky is not in Google Play, whose policy limits this. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Lets the service resolve the display name of launchable apps, and
         Pinky on the phone list and open them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pinky">

        <!-- Its own process, like any app Pinky reads: the accessibility
             cache does not refresh windows of the service's own process. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:process=":debug">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pinky's screen for tasks on the phone itself, in its own
             process too: the service must see it to keep agents off it.
             Shown only where on_phone_ui is true (development builds for
             now). -->
        <activity
            android:name=".TaskActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="true"
            android:label="@string/phone_launcher"
            android:launchMode="singleTask"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Its settings, opened only from it, in its process. -->
        <activity
            android:name=".SettingsActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:label="@string/phone_settings"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen"
            android:windowSoftInputMode="adjustResize" />

        <!-- Its history and a task of it, opened only from it, in its
             process. -->
        <activity
            android:name=".HistoryActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:label="@string/phone_activity"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen" />
        <activity
            android:name=".PastTaskActivity"
            android:enabled="@bool/on_phone_ui"
            android:exported="false"
            android:label="@string/phone_activity"
            android:process=":ui"
            android:theme="@style/Theme.Pinky.Screen" />

        <!-- Hears how an update from Pinky's releases went (UpdateInstall). -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:enabled="@bool/on_phone_ui"
            android:exported="false" />

        <service
            android:name=".PinkyAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
