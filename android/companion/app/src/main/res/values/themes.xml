<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pinky" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">#EE4D6C</item>
    </style>

    <!-- Pinky's own screens on the phone (TaskActivity, SettingsActivity):
         no action bar, desktop Pinky's accent, and the page's color behind
         the bars where the window is not edge to edge. -->
    <style name="Theme.Pinky.Screen" parent="Theme.Pinky">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/pinky_accent</item>
        <item name="android:windowBackground">@color/pinky_bg</item>
        <item name="android:statusBarColor">@color/pinky_bg</item>
        <item name="android:navigationBarColor">@color/pinky_bg</item>
        <item name="android:windowLightStatusBar">@bool/pinky_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/pinky_light_bars</item>
    </style>
</resources>
