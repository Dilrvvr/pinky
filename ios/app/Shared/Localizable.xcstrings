{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %lld s · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$lld s · %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$lld 秒 · %3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$lld 秒 · %3$@"
          }
        }
      }
    },
    "%lld steps" : {
      "comment" : "How many steps a task took",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld step"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld steps"
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld ステップ"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld 步"
                }
              }
            }
          }
        }
      }
    },
    "1. Open Settings › Privacy & Security › Developer Mode." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 「設定 › プライバシーとセキュリティ › デベロッパモード」を開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 打开「设置 › 隐私与安全性 › 开发者模式」。"
          }
        }
      }
    },
    "2. Choose to pair with “Pinky”." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 「Pinky」とのペアリングを選びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 选择与「Pinky」配对。"
          }
        }
      }
    },
    "3. Type the code below. It also comes as a notification." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 下のコードを入力します。コードは通知でも届きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 输入下面的配对码。配对码也会以通知的形式出现。"
          }
        }
      }
    },
    "API key" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API キー"
